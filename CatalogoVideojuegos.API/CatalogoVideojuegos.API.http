@host = http://localhost:5035

### Estado de la API
GET {{host}}/api/estado

### Desarrolladoras: listar
GET {{host}}/api/desarrolladoras

### Desarrolladoras: crear
POST {{host}}/api/desarrolladoras
Content-Type: application/json

{
  "nombre": "Nintendo",
  "pais": "Japón",
  "anioFundacion": 1889
}

### Plataformas: listar
GET {{host}}/api/plataformas

### Plataformas: crear
POST {{host}}/api/plataformas
Content-Type: application/json

{
  "nombre": "Nintendo Switch",
  "fabricante": "Nintendo",
  "anioLanzamiento": 2017
}

### Videojuegos: listar
GET {{host}}/api/videojuegos

### Videojuegos: crear
POST {{host}}/api/videojuegos
Content-Type: application/json

{
  "titulo": "The Legend of Zelda: Tears of the Kingdom",
  "genero": "Aventura",
  "precio": 69.99,
  "fechaLanzamiento": "2023-05-12",
  "desarrolladoraId": 1,
  "plataformaId": 1
}

### Reseñas: listar (opcionalmente ?videojuegoId=1)
GET {{host}}/api/resenas

### Reseñas: crear
POST {{host}}/api/resenas
Content-Type: application/json

{
  "videojuegoId": 1,
  "autor": "Johansel",
  "puntuacion": 9,
  "comentario": "Excelente exploración y mundo abierto."
}
